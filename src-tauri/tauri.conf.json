{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinguiñoño",
  "version": "1.0.2",
  "identifier": "com.pinguinono.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pinguiñoño - Aprende Linux Fácil",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Aprende Linux Fácil",
    "longDescription": "Pinguiñoño es una aplicación educativa para aprender Linux, Cloud y DevOps con terminal real integrada.",
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/pinguinono.desktop.hbs"
      }
    }
  }
}
