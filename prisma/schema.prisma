generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Usuario
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  avatar        String?
  locale        String    @default("es")
  totalXp       Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  progress      Progress[]
  examAttempts  ExamAttempt[]
  achievements  UserAchievement[]
  studySessions StudySession[]
  bookmarks     Bookmark[]
  reviewItems   ReviewItem[]
}

// Progreso del usuario
model Progress {
  id            String        @id @default(cuid())
  userId        String
  entityType    String        // COURSE, MODULE, LESSON, EXERCISE, LAB, EXAM, PROJECT, SKILL
  entityId      String
  status        String        @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, MASTERED, NEEDS_REVIEW
  score         Int?
  attempts      Int           @default(0)
  timeSpent     Int           @default(0) // segundos
  completedAt   DateTime?
  data          String?       // JSON para datos adicionales
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
}

// Intento de examen
model ExamAttempt {
  id            String    @id @default(cuid())
  userId        String
  examId        String
  moduleId      String
  score         Int
  totalPoints   Int
  passed        Boolean
  timeSpent     Int       // segundos
  answers       String    // JSON con respuestas detalladas
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([examId])
  @@index([moduleId])
}

// Logro/Insignia del sistema
model Achievement {
  id            String    @id @default(cuid())
  slug          String    @unique
  category      String    // PROGRESS, STREAK, MASTERY, SPECIAL
  icon          String
  xpReward      Int       @default(0)
  isHidden      Boolean   @default(false)
  requiredValue Int?      // Valor necesario para obtener (ej: 7 días de racha)
  createdAt     DateTime  @default(now())
  
  users         UserAchievement[]
}

// Logros obtenidos por el usuario
model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
}

// Sesión de estudio
model StudySession {
  id            String    @id @default(cuid())
  userId        String
  entityType    String?
  entityId      String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int?      // segundos
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Marcadores
model Bookmark {
  id            String    @id @default(cuid())
  userId        String
  entityType    String
  entityId      String
  note          String?
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, entityType, entityId])
}

// Items de repaso (repetición espaciada)
model ReviewItem {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  questionType  String
  moduleId      String
  easeFactor    Float     @default(2.5)
  interval      Int       @default(1)     // días
  repetitions   Int       @default(0)
  nextReview    DateTime  @default(now())
  lastReview    DateTime?
  lastScore     Int?      // 0-5 escala de facilidad
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, questionId])
  @@index([userId, nextReview])
}

// Configuración de la aplicación
model AppSettings {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  updatedAt     DateTime  @updatedAt
}
